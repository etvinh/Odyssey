# ---------------------------------------------------------------------------
# Dependencies and build output
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/
dist/
build/
coverage/
*.tgz

# Expo rewrites apps/dashboard/.gitignore on every start, purely to ignore
# expo-env.d.ts. Covered here instead, and its copy is ignored, so the repo
# keeps a single .gitignore.
expo-env.d.ts
apps/dashboard/.gitignore

# Tool caches
.turbo/
.expo/
.expo-shared/
.wrangler/
.eslintcache
*.tsbuildinfo

# NOTE: packages/api-client/src/generated/ and services/backend/openapi.json are
# COMMITTED on purpose — the generated contract should be readable on GitHub
# without cloning. See docs/adr/0004.

# ---------------------------------------------------------------------------
# Secrets. Nothing here should ever reach the remote.
# ---------------------------------------------------------------------------
# Real values live in .env; the committed template is .env.example.
.env
.env.*
!.env.example

# wrangler's default secrets filename. We use .env instead, but an unignored
# .dev.vars is a credentials file waiting for `git add -A`.
.dev.vars
.dev.vars.*

# Key material, in case any ever lands in the tree.
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*

# ---------------------------------------------------------------------------
# Not ours to publish / not part of the deliverable
# ---------------------------------------------------------------------------
# The assignment brief — the client's material. Kept locally, never committed.
INSTRUCTIONS.md

# Agent tooling conventions and local assistant state.
docs/agents/
.claude/
CLAUDE.local.md

# Issues, specs and working notes.
.scratch/

# ---------------------------------------------------------------------------
# Editor and OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
.AppleDouble
Thumbs.db

# ---------------------------------------------------------------------------
# Local scratch: logs, backups, merge and history-rewrite leftovers
# ---------------------------------------------------------------------------
*.log
*.bak
*.orig
*.rej
.git-rewrite/
