{
  "openapi": "3.1.0",
  "info": {
    "title": "Odyssey API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8787"
    }
  ],
  "components": {
    "schemas": {
      "MenuItemList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuItem"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ListMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "MenuItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "priceCents": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "isAvailable": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "categoryId",
          "name",
          "description",
          "priceCents",
          "isAvailable"
        ]
      },
      "ListMeta": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          }
        },
        "required": [
          "total",
          "page",
          "pageSize"
        ]
      },
      "ApiErrorBody": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "CreateMenuItemBody": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0
          },
          "isAvailable": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "categoryId",
          "name",
          "priceCents"
        ]
      },
      "UpdateMenuItemBody": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0
          },
          "isAvailable": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "MenuCategory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "sortOrder": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "itemCount": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "sortOrder",
          "itemCount"
        ]
      },
      "CreateMenuCategoryBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sortOrder": {
            "type": "integer"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateMenuCategoryBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sortOrder": {
            "type": "integer"
          }
        }
      },
      "MenuCategoryList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuCategory"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ListMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "OrderList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderRow"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/OrderListMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "OrderRow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "channel": {
            "type": "string",
            "enum": [
              "dine_in",
              "takeaway",
              "delivery"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "preparing",
              "ready",
              "completed",
              "cancelled"
            ]
          },
          "totalCents": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "orderNumber": {
            "type": "string"
          },
          "customer": {
            "$ref": "#/components/schemas/OrderRowCustomer"
          },
          "itemCount": {
            "type": "integer"
          },
          "placedAt": {
            "type": "string"
          },
          "allowedActions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderAction"
            }
          }
        },
        "required": [
          "id",
          "channel",
          "status",
          "totalCents",
          "orderNumber",
          "customer",
          "itemCount",
          "placedAt",
          "allowedActions"
        ]
      },
      "OrderRowCustomer": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "OrderAction": {
        "type": "string",
        "enum": [
          "confirm",
          "start_preparing",
          "mark_ready",
          "complete",
          "cancel"
        ]
      },
      "OrderListMeta": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ListMeta"
          },
          {
            "type": "object",
            "properties": {
              "statusCounts": {
                "$ref": "#/components/schemas/OrderStatusCounts"
              }
            },
            "required": [
              "statusCounts"
            ]
          }
        ]
      },
      "OrderStatusCounts": {
        "type": "object",
        "properties": {
          "pending": {
            "type": "integer"
          },
          "confirmed": {
            "type": "integer"
          },
          "preparing": {
            "type": "integer"
          },
          "ready": {
            "type": "integer"
          },
          "completed": {
            "type": "integer"
          },
          "cancelled": {
            "type": "integer"
          }
        },
        "required": [
          "pending",
          "confirmed",
          "preparing",
          "ready",
          "completed",
          "cancelled"
        ]
      },
      "OrderStatus": {
        "type": "string",
        "enum": [
          "pending",
          "confirmed",
          "preparing",
          "ready",
          "completed",
          "cancelled"
        ]
      },
      "OrderDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "channel": {
            "type": "string",
            "enum": [
              "dine_in",
              "takeaway",
              "delivery"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "preparing",
              "ready",
              "completed",
              "cancelled"
            ]
          },
          "totalCents": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "kitchenNote": {
            "type": [
              "string",
              "null"
            ]
          },
          "orderNumber": {
            "type": "string"
          },
          "customer": {
            "$ref": "#/components/schemas/OrderDetailCustomer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "timeline": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderTimelineEntry"
            }
          },
          "allowedActions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderAction"
            }
          }
        },
        "required": [
          "id",
          "channel",
          "status",
          "totalCents",
          "kitchenNote",
          "orderNumber",
          "customer",
          "items",
          "timeline",
          "allowedActions"
        ]
      },
      "OrderDetailCustomer": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "phone"
        ]
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "menuItemId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "unitPriceCents": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "quantity": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "lineTotalCents": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        },
        "required": [
          "id",
          "menuItemId",
          "name",
          "unitPriceCents",
          "quantity",
          "lineTotalCents"
        ]
      },
      "OrderTimelineEntry": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "changedAt": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "changedAt"
        ]
      },
      "CreateOrderBody": {
        "type": "object",
        "properties": {
          "customer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrderCustomerRef"
              },
              {
                "$ref": "#/components/schemas/OrderCustomerNew"
              }
            ]
          },
          "channel": {
            "type": "string",
            "enum": [
              "dine_in",
              "takeaway",
              "delivery"
            ]
          },
          "kitchenNote": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "menuItemId": {
                  "type": "string",
                  "format": "uuid"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "menuItemId",
                "quantity"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "channel",
          "items"
        ]
      },
      "OrderCustomerRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ]
      },
      "OrderCustomerNew": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "phone": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "preferences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name"
        ]
      },
      "OrderActionBody": {
        "type": "object",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/OrderAction"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/menu/items": {
      "get": {
        "operationId": "listMenuItems",
        "tags": [
          "Menu"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "categoryId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "required": false,
            "name": "available",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": false,
            "name": "search",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Every menu item that can still be ordered from.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItemList"
                }
              }
            }
          },
          "422": {
            "description": "The query parameters did not validate.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createMenuItem",
        "tags": [
          "Menu"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMenuItemBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The menu item as created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItem"
                }
              }
            }
          },
          "422": {
            "description": "The body did not validate, or the category does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/menu/items/{id}": {
      "patch": {
        "operationId": "updateMenuItem",
        "tags": [
          "Menu"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMenuItemBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The menu item as it now stands.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItem"
                }
              }
            }
          },
          "404": {
            "description": "No menu item with that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "The body did not validate, or the category does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteMenuItem",
        "tags": [
          "Menu"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "The item was removed from the menu."
          },
          "404": {
            "description": "No menu item with that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/menu/categories": {
      "post": {
        "operationId": "createMenuCategory",
        "tags": [
          "Menu"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMenuCategoryBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The category as created, holding nothing yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuCategory"
                }
              }
            }
          },
          "409": {
            "description": "Another category already uses that name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "The body did not validate.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listMenuCategories",
        "tags": [
          "Menu"
        ],
        "responses": {
          "200": {
            "description": "Every menu category, ordered for display.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuCategoryList"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/menu/categories/{id}": {
      "patch": {
        "operationId": "updateMenuCategory",
        "tags": [
          "Menu"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMenuCategoryBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The category as it now stands.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuCategory"
                }
              }
            }
          },
          "404": {
            "description": "No category with that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Another category already uses that name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "The body did not validate.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteMenuCategory",
        "tags": [
          "Menu"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "The category was removed."
          },
          "404": {
            "description": "No category with that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "The category still holds items.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders": {
      "get": {
        "operationId": "listOrders",
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/OrderStatus"
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": false,
            "name": "search",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "required": false,
            "name": "pageSize",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "placedAt.desc",
                "placedAt.asc"
              ],
              "default": "placedAt.desc"
            },
            "required": false,
            "name": "sort",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Orders, newest first, with live status counts in meta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderList"
                }
              }
            }
          },
          "422": {
            "description": "The query parameters did not validate.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createOrder",
        "tags": [
          "Orders"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The order as placed, priced by the server.",
            "content": {
              "application/json": {
                "schema": {
